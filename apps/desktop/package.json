{
  "name": "desktop",
  "version": "0.13.22",
  "description": "Lunarscribe Markdown writing app",
  "desktopName": "lunarscribe.desktop",
  "private": true,
  "type": "module",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "bun run setup:electron && electron-vite dev --watch",
    "setup:electron": "install-electron",
    "build": "electron-vite build",
    "package": "bun run build && electron-builder --publish never",
    "preview": "bun run setup:electron && electron-vite preview",
    "check-types": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@ff-labs/fff-node": "catalog:",
    "@tanstack/pacer": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@lunarscribe/components": "workspace:*",
    "@lunarscribe/utils": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.1.0",
    "docx": "catalog:",
    "electron": "^44.4.0",
    "electron-builder": "catalog:",
    "electron-vite": "^5.0.0",
    "lucide-react": "catalog:",
    "react-grab": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^7.3.0",
    "zustand": "catalog:"
  },
  "build": {
    "appId": "com.lunarscribe.app",
    "productName": "Lunarscribe",
    "directories": {
      "buildResources": "../../assets/icons",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "../../assets/icons/256x256.png",
        "to": "icons/256x256.png"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "icon": "icon.icns",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Plain text",
        "icon": "icon.icns",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ],
    "protocols": [
      {
        "name": "Lunarscribe",
        "schemes": [
          "lunarscribe"
        ]
      }
    ],
    "linux": {
      "icon": "256x256.png",
      "artifactName": "lunarscribe-linux-${arch}.${ext}",
      "executableName": "lunarscribe",
      "target": [
        "zip"
      ],
      "category": "Office",
      "mimeTypes": [
        "text/markdown",
        "text/x-markdown",
        "text/plain"
      ],
      "maintainer": "Lunarscribe contributors"
    },
    "mac": {
      "icon": "icon.icns",
      "artifactName": "lunarscribe-macos-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "asarUnpack": [
      "node_modules/@ff-labs/**",
      "node_modules/ffi-rs/**",
      "node_modules/@yuuang/**"
    ]
  }
}
