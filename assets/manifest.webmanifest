{
  "name": "Lunarscribe",
  "short_name": "Lunarscribe",
  "start_url": "/",
  "display": "standalone",
  "icons": [
    {
      "src": "/icons/192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "description": "Markdown writing app",
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/markdown": [".md", ".markdown"],
        "text/plain": [".txt"]
      },
      "launch_type": "single-client"
    }
  ]
}
